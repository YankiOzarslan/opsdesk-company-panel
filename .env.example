# Copy to .env. Never commit your real configuration.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_URL=http://localhost:4000
ADMIN_EMAIL=admin@example.com
# Generate your own hash: npm run hash-password -- "your-own-password"
ADMIN_PASSWORD_HASH=
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
COOKIE_SECURE=false
TRUST_PROXY=false
AUTO_BACKUP=true
AUTO_EXPIRY_SYNC=false
# Optional password-reset email configuration; user creation does not need SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OpsDesk <no-reply@example.com>
