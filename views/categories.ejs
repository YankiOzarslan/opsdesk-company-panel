<%- include('partials/header') %>
<div class="page-head"><div><h1><i class="bi bi-grid"></i>Teknoloji kategorileri</h1><p>Kategorileri ekibinizin çalışma biçimine göre düzenleyin.</p></div></div>
<% if(error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form class="card mb-4" method="post" action="/technology-categories"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="category-label">Yeni kategori</label><div class="d-flex gap-2"><input class="form-control" id="category-label" name="label" maxlength="100" placeholder="Ör. Belediye uygulamaları" required><button class="btn btn-primary text-nowrap">Kategori ekle</button></div></div></form>
<div class="card"><div class="card-body"><% for(const c of rows) { %><div class="d-flex flex-wrap align-items-center gap-3 py-3 border-bottom"><form class="d-flex align-items-center gap-2 flex-grow-1" action="/technology-categories/<%= c.key %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" name="label" aria-label="<%= c.label %> kategori adı" value="<%= c.label %>" maxlength="100" required><button class="btn btn-outline-primary">Kaydet</button></form><span class="small text-secondary"><%= c.used %> proje</span><form method="post" action="/technology-categories/<%= c.key %>/delete" data-confirm="Kategoriyi silmek istiyor musunuz?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" <%= c.used ? 'disabled' : '' %>>Sil</button></form></div><% } %></div></div>
<%- include('partials/footer') %>
