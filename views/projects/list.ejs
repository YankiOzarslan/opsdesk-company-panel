<section class="card project-list-panel" aria-label="Proje listesi">
  <div class="project-list-intro"><span><i class="bi bi-kanban me-2" aria-hidden="true"></i>Proje portföyü</span><small><%= matched %> proje eşleşti</small></div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 projects-table">
      <thead><tr><th>Proje / müşteri</th><th>Teknoloji / sürüm</th><th>Domain / sunucu</th><th>Ekip</th><th>Durum / yedek</th><th>İşlemler</th></tr></thead>
      <tbody>
        <% for (const r of rows) { const domainName=lk.domains.byId.get(r.domain_id); const serverName=lk.servers.byId.get(r.server_id); const clientName=lk.clients.byId.get(r.client_id); const team=(r.team_ids || []).map(id=>({id,name:lk.team.byId.get(id)})).filter(t=>t.name); %>
        <tr class="project-list-row">
          <td data-label="Proje / müşteri"><div class="project-list-identity"><span class="project-avatar" aria-hidden="true"><%= h.initials(r.name) %></span><div class="project-list-name"><a class="fw-semibold" href="/projects/<%= r.id %>"><%= r.name %></a><% if(clientName) { %><a class="project-meta" href="/clients/<%= r.client_id %>"><i class="bi bi-briefcase" aria-hidden="true"></i><%= clientName %></a><% } else { %><span class="project-meta">Müşteri belirtilmemiş</span><% } %></div></div><% if(r.updated_at) { %><small class="project-updated">Güncelleme: <%= h.formatDateTime(r.updated_at) %></small><% } %></td>
          <td data-label="Teknoloji / sürüm"><div class="project-stack-title"><i class="bi bi-code-slash" aria-hidden="true"></i><strong><%= r.technology || 'Teknoloji belirtilmemiş' %></strong><% if(r.tech_version) { %><span class="badge text-bg-light border"><%= r.tech_version %></span><% } %></div><% if(r.tech_category) { %><span class="project-meta"><%= h.display(entity,'tech_category',r.tech_category,lk).text %></span><% } %><% if(r.language) { %><span class="project-meta"><%= r.language %><%= r.language_version ? ` ${r.language_version}` : '' %></span><% } %><% if(r.framework) { %><details class="project-stack-details"><summary>Diğer teknolojiler</summary><p><%= r.framework %></p></details><% } %></td>
          <td data-label="Domain / sunucu"><div class="project-resource"><i class="bi bi-globe2" aria-hidden="true"></i><div><% if(domainName) { %><a href="/domains/<%= r.domain_id %>"><%= domainName %></a><a class="project-site-open" href="https://<%= domainName %>" target="_blank" rel="noopener noreferrer" aria-label="<%= domainName %> sitesini aç"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a><% } else { %><span class="project-missing">Domain bağlanmamış</span><% } %></div></div><div class="project-resource"><i class="bi bi-hdd-rack" aria-hidden="true"></i><div><% if(serverName) { %><a href="/servers/<%= r.server_id %>"><%= serverName %></a><% } else { %><span class="project-missing">Sunucu bağlanmamış</span><% } %></div></div><% if(r.deploy_path) { %><small class="project-meta project-deploy"><%= r.deploy_path %></small><% } %></td>
          <td data-label="Ekip"><% if(team.length) { %><div class="project-team-list"><% for(const t of team) { %><a href="/team/<%= t.id %>"><i class="bi bi-person" aria-hidden="true"></i><span><%= t.name %></span></a><% } %></div><% } else { %><span class="project-missing">Ekip atanmamış</span><% } %></td>
          <td data-label="Durum / yedek"><div class="project-health"><span><%- include('../partials/value',{d:h.display(entity,'status',r.status,lk)}) %></span><span class="project-backup <%= r.backup_enabled ? 'is-on' : 'is-off' %>"><i class="bi <%= r.backup_enabled ? 'bi-shield-check' : 'bi-shield-exclamation' %>" aria-hidden="true"></i>Yedek <%= r.backup_enabled ? 'aktif' : 'kapalı' %></span><% if(r.backup_enabled && r.backup_schedule) { %><small class="project-meta"><%= r.backup_schedule %></small><% } %></div></td>
          <td data-label="İşlemler"><div class="project-action-stack"><a class="btn btn-sm btn-outline-secondary" href="/projects/<%= r.id %>" aria-label="<%= r.name %> detayları"><i class="bi bi-eye" aria-hidden="true"></i>Detay</a><% if(r.canEdit) { %><a class="btn btn-sm btn-outline-secondary" href="/projects/<%= r.id %>/edit" aria-label="<%= r.name %> projesini düzenle"><i class="bi bi-pencil" aria-hidden="true"></i>Düzenle</a><% } %><% if(r.canDelete) { %><form method="post" action="/projects/<%= r.id %>/delete" data-confirm="<%= r.name %> projesi kalıcı olarak silinecek. Bağlı domain, sunucu ve müşteri kayıtları korunur. Silmek istediğinize emin misiniz?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" type="submit" aria-label="<%= r.name %> projesini sil"><i class="bi bi-trash" aria-hidden="true"></i>Sil</button></form><% } %></div></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
