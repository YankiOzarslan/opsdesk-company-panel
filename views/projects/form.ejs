<%- include('../partials/header') %>
<% const steps = entity.sections; const stepIcons = ['bi-info-circle', 'bi-cpu', 'bi-hdd-network', 'bi-person-check']; %>
<div class="page-head">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1">
      <li class="breadcrumb-item"><a href="/projects">Projeler</a></li>
      <% if (mode === 'edit') { %><li class="breadcrumb-item"><a href="/projects/<%= id %>"><%= values.name %></a></li><% } %>
      <li class="breadcrumb-item active" aria-current="page"><%= mode === 'create' ? 'Yeni' : 'Düzenle' %></li>
    </ol></nav>
    <h1 class="h3 mb-0"><i class="bi bi-kanban me-2 text-primary"></i><%= title %></h1>
  </div>
</div>
<%- include('../partials/form-errors', { errors, entity }) %>

<ol class="wizard-steps" id="wizardSteps" aria-label="Form adımları">
  <% steps.forEach((s, i) => { const hasErr = entity.fields.some((f) => f.section === s && !f.hidden && errors[f.name]); %>
    <li class="wizard-step <%= i === 0 ? 'active' : '' %> <%= hasErr ? 'has-error' : '' %>" data-step="<%= i %>">
      <button type="button" class="wizard-step-btn" data-goto="<%= i %>">
        <span class="wizard-dot"><i class="bi <%= stepIcons[i] %>"></i></span>
        <span class="wizard-label"><small>Adım <%= i + 1 %></small><%= s %></span>
      </button>
    </li>
  <% }) %>
</ol>

<% if (locals.techCatalogJson) { %><script type="application/json" id="techCatalog"><%- techCatalogJson %></script><% } %>
<form method="post" action="<%= action %>" class="entity-form wizard-form" id="projectForm" data-draft-form data-wizard data-mode="<%= mode %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% steps.forEach((s, i) => { const fields = entity.fields.filter((f) => f.section === s && !f.hidden); %>
    <section class="form-section card mb-3 wizard-pane" data-pane="<%= i %>" aria-labelledby="pane-title-<%= i %>">
      <div class="card-body">
        <h2 class="form-section-title" id="pane-title-<%= i %>"><span class="form-section-num"><%= i + 1 %></span><%= s %></h2>
        <% if (s === 'Temel') { %>
          <div class="lookup-bar border rounded p-3 mb-4" data-project-domain>
            <label class="form-label" for="project-domain-input">Domain / site adresi</label>
            <div class="d-flex flex-wrap gap-2"><input class="form-control project-domain-query" id="project-domain-input" name="domain_lookup" placeholder="ornek.com" value="<%= domainInput %>" autocomplete="off"><button type="button" class="btn btn-outline-primary" id="project-domain-lookup"><i class="bi bi-search me-1"></i>Bilgileri getir</button></div>
            <p class="form-text mb-2">Domaini yazınca bilgiler otomatik sorgulanır. Bulunamayan alanları elle doldurabilirsiniz. Yeni domain, projeyi kaydettiğinizde eklenir.</p>
            <div id="project-domain-result" class="small" role="status" aria-live="polite"></div>
            <details class="mt-3"><summary class="small text-secondary">Domain bilgileri / elle düzenle</summary><div class="row g-3 mt-1">
              <% for(const [field,label,type] of [['registrar','Kayıt firması','text'],['expiry_date','Domain bitiş tarihi','date'],['registered_at','Kayıt tarihi','date'],['ssl_issuer','SSL sağlayıcısı','text'],['ssl_expiry','SSL bitiş tarihi','date'],['dns_managed_by','DNS yönetimi','text']]) { %><div class="col-12 col-md-6"><label class="form-label" for="project-domain-<%= field %>"><%= label %></label><input class="form-control" id="project-domain-<%= field %>" type="<%= type %>" name="domain_<%= field %>" value="<%= domainMetadata[field] %>"></div><% } %>
              <div class="col-12"><label class="form-label" for="project-domain-nameservers">Name server’lar</label><textarea class="form-control" id="project-domain-nameservers" name="domain_nameservers" rows="2"><%= domainMetadata.nameservers %></textarea></div>
            </div></details>
          </div>
        <% } %>
        <% if (s === 'Teknoloji') { %>
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3"><p class="small text-secondary mb-0">Site adresinden teknoloji ve yayımlanan sürümler algılanır. Bulunamayan alanları elle doldurabilirsiniz.</p><button type="button" class="btn btn-outline-primary" id="project-tech-lookup"><i class="bi bi-search me-1"></i>Siteden algıla</button></div>
          <div id="project-tech-result" class="small text-secondary mb-4" role="status" aria-live="polite">Sürüm bilgisi yalnızca site açıkça yayımlıyorsa doldurulur.</div>
          <div id="project-tech-apply-panel" class="d-none mb-4"><p class="small text-secondary mb-2">Sonuçları uygulamak mevcut teknoloji alanlarını değiştirir. Tespit edilemeyen sürümler boş bırakılır; kayıt için Kaydet düğmesine basın.</p><button type="button" class="btn btn-outline-primary btn-sm" id="project-tech-apply">Sonuçları teknoloji alanlarına uygula</button></div>
        <% } %>
        <div class="row g-3">
          <% for (const f of fields) { %><%- include('../partials/field', { f: f.name==='name'?{...f,required:false,placeholder:'Boş bırakırsanız domain adı kullanılır'}:f, values, errors, lk, datalists }) %><% } %>
        </div>
      </div>
    </section>
  <% }) %>

  <div class="form-actions">
    <a class="btn btn-outline-secondary me-auto" href="<%= mode === 'edit' ? `/projects/${id}` : '/projects' %>">Vazgeç</a>
    <button class="btn btn-outline-primary" type="button" data-prev><i class="bi bi-arrow-left me-1"></i>Geri</button>
    <button class="btn btn-primary" type="button" data-next>İleri<i class="bi bi-arrow-right ms-1"></i></button>
    <button class="btn btn-success" type="submit" data-submit><i class="bi bi-check-lg me-1"></i><%= mode === 'create' ? 'Projeyi oluştur' : 'Kaydet' %></button>
  </div>
</form>
<%- include('../partials/footer') %>
