<%- include('partials/header') %>
<%
const stats = [
 {label:'Projeler', value:counts.projects, sub:`${counts.activeProjects} proje yayında`, icon:'bi-kanban', href:'/projects', tone:'primary'},
 {label:'Domainler', value:counts.domains, sub:`${counts.managedDomains} domain yönetimimizde`, icon:'bi-globe2', href:'/domains', tone:'info'},
 {label:'Sunucular', value:counts.servers, sub:'Altyapı envanteriniz', icon:'bi-hdd-rack', href:'/servers', tone:'success'},
 {label:'Müşteriler', value:counts.clients, sub:`${counts.contacts} kişi iletişim rehberinde`, icon:'bi-briefcase', href:'/clients', tone:'warning'}
];
const attention = counts.noBackup + expiringTotal + noExpiry + sslExpiring;
%>
<div class="page-head dashboard-heading"><div><div class="eyebrow">OPSDESK / GENEL BAKIŞ</div><h1>Her şey kontrolünüzde.</h1><p class="text-secondary mb-0">Merhaba<%= locals.account && account.name ? `, ${account.name.split(' ')[0]}` : '' %>. İşinize kuş bakışı bakın, kaldığınız yerden devam edin.</p></div><div class="today-label"><i class="bi bi-calendar3"></i><%= new Intl.DateTimeFormat('tr-TR', { day:'numeric',month:'long',year:'numeric', timeZone:'Europe/Istanbul' }).format(new Date()) %></div></div>
<section class="workspace-launcher" aria-label="Çalışma alanına hızlı erişim">
  <div class="launcher-main">
    <span class="banner-kicker"><span class="signal-dot"></span> ÇALIŞMA ALANINIZ</span>
    <h2>Nereden başlayalım?</h2>
    <nav class="launcher-links" aria-label="Hızlı erişim">
      <% for (const item of [...stats, {label:'İletişim rehberi', value:counts.contacts, icon:'bi-person-lines-fill', href:'/contacts'}, {label:'Ekip', value:counts.team, icon:'bi-people', href:'/team'}]) { %>
      <a class="launcher-link" href="<%= item.href %>"><i class="bi <%= item.icon %>" aria-hidden="true"></i><span><%= item.label %></span><span class="launcher-count"><%= item.value %></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
      <% } %>
    </nav>
  </div>
  <% const clockNow = new Date(); %>
  <div class="workspace-clock" aria-label="İstanbul tarih ve saati">
    <span class="clock-location"><i class="bi bi-clock" aria-hidden="true"></i> İSTANBUL</span>
    <time data-workspace-time datetime="<%= clockNow.toISOString() %>"><%= new Intl.DateTimeFormat('tr-TR', {hour:'2-digit', minute:'2-digit', second:'2-digit', timeZone:'Europe/Istanbul'}).format(clockNow) %></time>
    <span data-workspace-date><%= new Intl.DateTimeFormat('tr-TR', {day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Istanbul'}).format(clockNow) %></span>
    <span class="clock-weekday" data-workspace-weekday><%= new Intl.DateTimeFormat('tr-TR', {weekday:'long',timeZone:'Europe/Istanbul'}).format(clockNow) %></span>
  </div>
</section>
<div class="dashboard-grid"><div class="dashboard-primary"><section class="card projects-panel"><div class="card-header section-header"><div><h2>Proje portföyü</h2><p>Son eklenen projeleriniz ve güncel durumları</p></div><a class="section-link" href="/projects">Tüm projeler <i class="bi bi-arrow-right"></i></a></div>
<% if (!recentProjects.length) { %><div class="card-body"><%- include('partials/empty', {icon:'bi-kanban',heading:'Sıradaki büyük işiniz burada başlıyor',text:'İlk projenizi ekleyin, tüm detaylarını bir arada tutun.',href:'/projects/new',cta:'İlk projeyi ekle'}) %></div><% } else { %><div class="table-responsive"><table class="table table-hover align-middle portfolio-table"><thead><tr><th>Proje / site</th><th>Teknoloji</th><th>Durum</th><th><span class="visually-hidden">Aç</span></th></tr></thead><tbody><% for (const p of recentProjects) { const st=h.display(entities.projects,'status',p.status,lk); const dm=h.display(entities.projects,'domain_id',p.domain_id,lk); %><tr><td><div class="project-cell"><span class="project-avatar"><%= h.initials(p.name) %></span><div><a class="fw-semibold" href="/projects/<%= p.id %>"><%= p.name %></a><div class="small text-secondary"><%= dm.empty ? 'Domain bağlanmamış' : dm.text %></div></div></div></td><td><span class="technology-label"><i class="bi bi-code-slash"></i> <%= p.technology || 'Belirtilmemiş' %></span><% if(p.tech_version) { %><small class="d-block text-secondary"><%= p.tech_version %></small><% } %></td><td><%- include('partials/value',{d:st}) %></td><td><a class="project-open" aria-label="<%= p.name %> detaylarını aç" href="/projects/<%= p.id %>"><i class="bi bi-arrow-up-right"></i></a></td></tr><% } %></tbody></table></div><div class="portfolio-footer"><span><%= counts.projects %> proje kayıtlı</span><a href="/projects/new"><i class="bi bi-plus-lg me-1"></i>Yeni proje ekle</a></div><% } %></section>
<section class="card activity-panel"><div class="card-header section-header"><div><h2>Çalışma alanında neler oluyor?</h2><p>Ekibin son işlemleri</p></div><a class="section-link" href="/audit">Tüm hareketler <i class="bi bi-arrow-right"></i></a></div><% if (!recentChanges.length) { %><div class="card-body"><%- include('partials/empty',{icon:'bi-clock-history',heading:'Henüz bir hareket yok',text:'Ekibinizin yaptığı değişiklikler burada görünecek.',href:null}) %></div><% } else { %><ul class="list-group list-group-flush"><% for (const a of recentChanges.slice(0,4)) { %><%- include('partials/audit-item',{a,compact:true}) %><% } %></ul><% } %></section></div>
<aside class="dashboard-secondary"><section class="card attention-panel"><div class="card-header section-header"><div><h2><i class="bi bi-crosshair me-2"></i>Gözünüzden kaçmasın</h2><p>İlginizi bekleyen başlıklar</p></div><span class="attention-count"><%= attention %></span></div><div class="attention-body"><% if (counts.noBackup) { %><a class="attention-item" href="/projects"><span class="attention-icon"><i class="bi bi-shield-exclamation"></i></span><div><strong>Yedeklemeyi tamamlayın</strong><p><%= counts.noBackup %> projede yedekleme kapalı. Proje detayından düzenleyin.</p></div><i class="bi bi-chevron-right"></i></a><% } %><% if(noExpiry) { %><a class="attention-item" href="/domains"><span class="attention-icon"><i class="bi bi-calendar-plus"></i></span><div><strong>Eksik tarihleri ekleyin</strong><p><%= noExpiry %> domainin bitiş tarihi belirtilmemiş.</p></div><i class="bi bi-chevron-right"></i></a><% } %><% if(expiringTotal) { %><a class="attention-item" href="/domains?expiring=60"><span class="attention-icon"><i class="bi bi-hourglass-split"></i></span><div><strong>Yenileme zamanı yaklaşıyor</strong><p><%= expiringTotal %> domainin süresi 60 gün içinde doluyor veya geçmiş.</p></div><i class="bi bi-chevron-right"></i></a><% } %><% if(sslExpiring) { %><a class="attention-item" href="/domains?ssl_expiring=30"><span class="attention-icon"><i class="bi bi-shield-exclamation"></i></span><div><strong>SSL sertifikalarını kontrol edin</strong><p><%= sslExpiring %> sertifika 30 gün içinde doluyor veya süresi geçmiş. Kayıtları canlı kontrolle yenileyin.</p></div><i class="bi bi-chevron-right"></i></a><% } %><% if(!attention) { %><div class="all-clear"><i class="bi bi-check2-circle"></i><strong>Listeniz tertemiz.</strong><p>Şu an dikkat gerektiren bir kayıt görünmüyor.</p></div><% } %></div></section>
<section class="card renewal-panel"><div class="card-header section-header"><div><h2>Yenileme takvimi</h2><p>Önümüzdeki 60 gün · Domainler</p></div><i class="bi bi-calendar3 text-secondary"></i></div><% if(!expiring.length) { %><div class="renewal-empty"><span><i class="bi bi-calendar2-check"></i></span><strong>Yaklaşan yenileme yok</strong><p>Önümüzdeki 60 günde süresi<br>dolan bir domain bulunmuyor.</p></div><% } else { %><ul class="list-group list-group-flush"><% for(const d of expiring) { const b=h.expiryBadge(d.expiry_date); %><li class="list-group-item"><a class="fw-semibold" href="/domains/<%= d.id %>"><%= d.name %></a><div class="d-flex justify-content-between mt-2 small"><span class="text-secondary"><%= h.formatDate(d.expiry_date) %></span><span class="badge <%= b.cls %>"><%= b.text %></span></div></li><% } %></ul><% } %><a class="panel-bottom-link" href="/domains?expiring=60">Domainleri görüntüle <i class="bi bi-arrow-right"></i></a></section>
<section class="quick-links"><div class="eyebrow">BİR SONRAKİ ADIM</div><a href="/clients/new"><span class="quick-link-icon"><i class="bi bi-building-add"></i></span><div><strong>Müşterinizi ekleyin</strong><small>İletişim bilgileri hep elinizin altında.</small></div><i class="bi bi-arrow-up-right"></i></a><a href="/team"><span class="quick-link-icon"><i class="bi bi-people"></i></span><div><strong>Ekibinizle bağlantıda kalın</strong><small><%= counts.team %> kayıtlı ekip üyesi</small></div><i class="bi bi-arrow-up-right"></i></a></section></aside></div>
<footer class="workspace-footer"><span><span class="footer-symbol">◇</span> OpsDesk</span><span>Daha az karmaşa. Daha çok üretim.</span></footer>
<%- include('partials/footer') %>
