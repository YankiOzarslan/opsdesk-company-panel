<% if (typeof user !== 'undefined' && user) { %><%- include('partials/header', { active: '' }) %><% } else { %><%- include('partials/head') %><body class="login-body"><main class="login-card card"><div class="card-body p-5"><% } %>
<div class="empty-state">
  <div class="empty-icon"><i class="bi <%= status === 404 ? 'bi-signpost-split' : status === 403 ? 'bi-shield-lock' : 'bi-exclamation-triangle' %>"></i></div>
  <h1 class="h3"><%= status %> — <%= title %></h1>
  <p class="text-secondary"><%= message %></p>
  <a class="btn btn-primary" href="/"><i class="bi bi-house me-1"></i>Ana sayfa</a>
</div>
<% if (typeof user !== 'undefined' && user) { %><%- include('partials/footer') %><% } else { %></div></main></body></html><% } %>
