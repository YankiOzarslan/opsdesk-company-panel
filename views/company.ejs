<%- include('partials/header') %>
<div class="page-head"><div><h1><i class="bi bi-building text-primary"></i>Şirket ayarları</h1><p class="text-secondary mb-0">Ortak çalışma alanının adını ve destek iletişimini düzenleyin.</p></div></div>
<% if(error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form class="card company-form" method="post" action="/company"><div class="card-body"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="company_name">Şirket adı *</label><input class="form-control" id="company_name" name="name" maxlength="100" value="<%= values.name || '' %>" required autocomplete="organization"></div><div class="mb-3"><label class="form-label" for="industry">Faaliyet alanı</label><input class="form-control" id="industry" name="industry" value="<%= values.industry || '' %>" maxlength="100" placeholder="Örn. Dijital ajans, yazılım, danışmanlık"></div><div class="mb-4"><label class="form-label" for="support_email">Çalışanların yardım isteyeceği e-posta</label><input class="form-control" id="support_email" name="support_email" type="email" value="<%= values.support_email || '' %>" autocomplete="email"><div class="form-text">Bu adres yardım ekranında şirket çalışanlarına gösterilir.</div></div><button class="btn btn-primary" type="submit">Şirket bilgilerini kaydet</button></div></form>
<%- include('partials/footer') %>
