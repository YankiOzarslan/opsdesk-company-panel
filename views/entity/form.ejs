<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1">
      <li class="breadcrumb-item"><a href="/<%= entity.key %>"><%= entity.plural %></a></li>
      <% if (mode === 'edit') { %><li class="breadcrumb-item"><a href="/<%= entity.key %>/<%= id %>"><%= values.name %></a></li><% } %>
      <li class="breadcrumb-item active" aria-current="page"><%= mode === 'create' ? 'Yeni' : 'Düzenle' %></li>
    </ol></nav>
    <h1 class="h3 mb-0"><i class="bi <%= entity.icon %> me-2 text-primary"></i><%= title %></h1>
  </div>
</div>
<% if (entity.key === 'domains') { %><p class="small text-secondary">Alt domain kaydı için ana domaini seçin ve tam adresi yazın (ör. panel.ornek.com). Yenileme tarihleri ana domainden takip edilir.</p><% } %>
<%- include('../partials/form-errors', { errors, entity }) %>
<form method="post" action="<%= action %>" class="entity-form" data-draft-form novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (entity.key === 'domains' || entity.key === 'servers') { %>
    <div class="card lookup-bar mb-3" data-lookup-url="/<%= entity.key %>/lookup" data-lookup-kind="<%= entity.key %>">
      <div class="card-body d-flex flex-wrap align-items-center gap-2 py-2">
        <i class="bi bi-cloud-download text-primary"></i>
        <span class="small text-secondary me-auto"><%= entity.key === 'domains'
          ? 'Alan adını yazın; registrar, kayıt / bitiş tarihi, name server ve SSL bilgileri RDAP / WHOIS / DNS üzerinden doldurulur.'
          : 'Hostname veya IP adresini yazın; IP, ters DNS, ağ sağlayıcısı ve ülke bilgileri doldurulur.' %></span>
        <button type="button" class="btn btn-sm btn-outline-primary" id="lookupBtn"><i class="bi bi-search me-1"></i>Bilgileri getir</button>
      </div>
      <div class="px-3 pb-3 d-none" id="lookupResult"></div>
    </div>
  <% } %>
  <%- include('../partials/form-sections', { entity, values, errors, lk, datalists, sectionList: entity.sections }) %>
  <div class="form-actions">
    <a class="btn btn-outline-secondary" href="<%= mode === 'edit' ? `/${entity.key}/${id}` : `/${entity.key}` %>">Vazgeç</a>
    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i><%= mode === 'create' ? 'Oluştur' : 'Kaydet' %></button>
  </div>
</form>
<%- include('../partials/footer') %>
