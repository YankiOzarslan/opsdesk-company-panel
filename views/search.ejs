<%- include('partials/header') %>
<div class="page-head"><div><h1><i class="bi bi-search text-primary"></i>Genel arama</h1><p class="text-secondary mb-0">Proje, domain, sunucu, müşteri, kişi ve ekip kayıtlarında arayın.</p></div></div>
<form class="card mb-3" method="get" action="/search"><div class="card-body d-flex gap-2"><label class="visually-hidden" for="global-query">Tüm kayıtlarda ara</label><input type="search" class="form-control" id="global-query" name="q" value="<%= q %>" maxlength="200" placeholder="Bir ad, domain veya teknoloji yazın…" required><button type="submit" class="btn btn-primary">Ara</button></div></form>
<% if(!q) { %><div class="card"><div class="card-body text-secondary">Aramak istediğiniz bilgiyi yazın. Yalnızca erişebildiğiniz kayıtlar gösterilir.</div></div>
<% } else if(!total) { %><div class="card"><div class="card-body"><%- include('partials/empty',{icon:'bi-search',heading:'Sonuç bulunamadı',text:'Farklı bir ad, domain veya teknoloji deneyin.',href:null}) %></div></div>
<% } else { %><p class="small text-secondary"><%= total %> kayıt eşleşti</p><div class="search-groups"><% for(const group of groups) { %><section class="card"><div class="card-header section-header"><h2><i class="bi <%= group.icon %> me-2" aria-hidden="true"></i><%= group.label %> <span class="badge text-bg-light"><%= group.total %></span></h2><a class="section-link" href="<%= h.qs('/'+group.key,{q}) %>">Tüm sonuçlar</a></div><ul class="list-group list-group-flush"><% for(const item of group.rows) { %><li class="list-group-item"><a class="search-result" href="/<%= group.key %>/<%= item.id %>"><span><strong><%= item.name %></strong><% if(item.description) { %><small><%= item.description %></small><% } %></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></li><% } %></ul></section><% } %></div><% } %>
<%- include('partials/footer') %>
