<%- include('partials/header') %>
<div class="page-head"><div><h1><i class="bi bi-activity text-primary"></i>Sistem durumu</h1><p class="text-secondary mb-0">Kayıt kalitesi, yedekleme ve servislerin mevcut durumu</p></div></div>
<div class="system-grid"><section class="card"><div class="card-header section-header"><h2>Tamamlanması gereken kayıtlar</h2></div><ul class="list-group list-group-flush"><% for(const item of issues) { %><li class="list-group-item"><a class="system-check-link" href="<%= item.href %>"><span><%= item.label %></span><span class="badge <%= item.count?'text-bg-warning':'text-bg-success' %>"><%= item.count %></span></a></li><% } %></ul></section>
<section class="card"><div class="card-header section-header"><h2>Servisler ve yedekler</h2></div><div class="card-body system-services"><div><span>Otomatik yedekleme</span><strong><%= autoBackup?'Açık':'Kapalı' %></strong></div><div><span>Son otomatik yedek</span><strong><%= lastAuto?h.formatDateTime(lastAuto.mtime):'Henüz yok' %></strong></div><div><span>Kayıtlı yedekler</span><a href="/backups"><%= backupCount %> yedek</a></div><div><span>Otomatik domain kontrolü</span><strong><%= autoExpirySync?'Açık':'Kapalı' %></strong></div><div><span>Son domain kontrolü</span><strong><%= verification?.finishedAt?h.formatDateTime(verification.finishedAt):'Henüz yapılmadı' %></strong></div><div><span>E-posta servisi (SMTP)</span><strong><%= smtpConfigured?'Yapılandırıldı':'Yapılandırılmadı' %></strong></div><% if(!smtpConfigured) { %><p class="small text-secondary mb-0">Davet ve parola sıfırlama e-postaları gönderilemez. Kullanıcılar ekranındaki mevcut davet bağlantısını kullanabilirsiniz.</p><% } %></div></section></div>
<%- include('partials/footer') %>
