<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-database-down me-2 text-primary"></i>Yedekler</h1>
    <p class="text-secondary mb-0">Günlük otomatik yedek (24 saatte bir) ve manuel yedekler</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" href="/backups/export"><i class="bi bi-download me-1"></i>Anlık DB indir</a>
    <form method="post" action="/backups">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg me-1"></i>Şimdi yedek al</button>
    </form>
  </div>
</div>
<div class="row g-3 mb-3">
  <div class="col-12 col-md-6">
    <div class="card h-100"><div class="card-body d-flex gap-3 align-items-center">
      <div class="stat-icon text-bg-success"><i class="bi bi-arrow-repeat"></i></div>
      <div>
        <div class="small text-secondary">Son otomatik yedek</div>
        <div class="fw-semibold"><%= lastAuto ? h.formatDateTime(lastAuto.mtime) : 'Henüz yok' %></div>
      </div>
    </div></div>
  </div>
  <div class="col-12 col-md-6">
    <div class="card h-100"><div class="card-body d-flex gap-3 align-items-center">
      <div class="stat-icon text-bg-info"><i class="bi bi-archive"></i></div>
      <div>
        <div class="small text-secondary">Toplam yedek</div>
        <div class="fw-semibold"><%= list.length %> dosya · <%= h.formatBytes(list.reduce((n, b) => n + b.size, 0)) %></div>
      </div>
    </div></div>
  </div>
</div>
<div class="card">
  <% if (!list.length) { %>
    <div class="card-body"><%- include('partials/empty', { icon: 'bi-database', heading: 'Yedek yok', text: '“Şimdi yedek al” ile ilk yedeği oluşturun.', href: null }) %></div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Dosya</th><th>Tür</th><th class="d-none d-md-table-cell">Tarih</th><th class="d-none d-sm-table-cell">Boyut</th><th class="text-end"><span class="visually-hidden">İşlemler</span></th></tr></thead>
        <tbody>
          <% for (const b of list) { %>
            <tr>
              <td><code><%= b.name %></code></td>
              <td><span class="badge <%= b.kind === 'auto' ? 'text-bg-success' : 'text-bg-primary' %>"><%= b.kind === 'auto' ? 'Otomatik' : 'Manuel' %></span></td>
              <td class="d-none d-md-table-cell"><%= h.formatDateTime(b.mtime) %></td>
              <td class="d-none d-sm-table-cell"><%= h.formatBytes(b.size) %></td>
              <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" href="/backups/download/<%= encodeURIComponent(b.name) %>" title="İndir" aria-label="İndir"><i class="bi bi-download"></i></a>
                <form class="d-inline" method="post" action="/backups/delete/<%= encodeURIComponent(b.name) %>" data-confirm="Bu yedek silinsin mi?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit" title="Sil" aria-label="Sil"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<p class="small text-secondary mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Yedek dosyaları SQLite formatındadır; geri yüklemek için sunucuyu durdurup dosyayı <code>data/opsdesk.db</code> olarak kopyalayın.</p>
<%- include('partials/footer') %>
